# Application
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database (defaults to embedded H2 when omitted)
DB_URL=jdbc:mysql://localhost:3306/opspilot?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=opspilot
DB_PASSWORD=replace-me
DB_DRIVER=com.mysql.cj.jdbc.Driver

# AI is optional. Core incident workflows run without it.
AI_ENABLED=false
DASHSCOPE_API_KEY=

# Retrieval snapshots are redacted before persistence and purged on this lifecycle.
RUNBOOK_RETRIEVAL_RETENTION=P30D
RUNBOOK_RETRIEVAL_CLEANUP_BATCH_SIZE=500
RUNBOOK_RETRIEVAL_CLEANUP_CRON=0 15 3 * * *

# Optional external metrics provider. Local reproducible evidence is used when disabled.
PROMETHEUS_ENABLED=false
PROMETHEUS_BASE_URL=http://localhost:9090
PROMETHEUS_QUERY_TEMPLATE=up{job="%s"}
PROMETHEUS_CONNECT_TIMEOUT=2s
PROMETHEUS_READ_TIMEOUT=4s

# Optional external logs provider. Keep credentials outside version control.
LOKI_ENABLED=false
LOKI_BASE_URL=http://localhost:3100
LOKI_QUERY_TEMPLATE={resource_code="%s"}
LOKI_TENANT_ID=
LOKI_BEARER_TOKEN=
LOKI_CONNECT_TIMEOUT=2s
LOKI_READ_TIMEOUT=5s

OBSERVABILITY_MAX_ATTEMPTS=2
OBSERVABILITY_RETRY_BACKOFF=150ms
OBSERVABILITY_FAILURE_THRESHOLD=3
OBSERVABILITY_OPEN_DURATION=30s
